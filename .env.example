# Kit (formerly ConvertKit) form ID for the beta signup form.
#
# This must be the NUMERIC form ID from the real
# <form action="https://app.kit.com/forms/{ID}/subscriptions"> markup.
# It is NOT the `data-uid` hash shown in Kit's dashboard <script async
# data-uid="..."> embed snippet — that's a different, unrelated ID for
# Kit's widget loader. See the comment at the top of
# src/lib/submitSignup.ts for how to find the real one.
VITE_KIT_FORM_ID=

# Cloudflare Turnstile site key for the signup form's "click the box"
# verification widget. Get one free at https://dash.cloudflare.com/ →
# Turnstile → Add site (no billing info required). Use the SITE key here,
# not the secret key — the secret key is only for server-side verification,
# which this project doesn't do (no backend) — see src/components/Turnstile.tsx.
VITE_TURNSTILE_SITE_KEY=
